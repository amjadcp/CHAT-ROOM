<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Group Audio Chat</title>
    <link rel="stylesheet" href="/css/styles.css">
  </head>
  <body>
    <h2 id="username">Loading...</h2>

    <div class="controls">
      <button id="toggleLocalMicBtn">🎤 Unmute</button>
      <button id="leaveRoom" disabled>Leave Room</button>
    </div>

    <div class="container">
      <div class="left-panel">
        <div id="myRoom">
          <h3>My Room</h3>
          <p class="empty-room-msg">Drag or tap users to add them</p>
        </div>
        <div id="remoteAudioContainer"></div>
      </div>

      <div class="right-panel">
        <h3>Available Users</h3>
        <ul id="usersList"></ul>
      </div>
    </div>

    <!-- Touch indicator for visual feedback -->
    <div class="touch-indicator" id="touchIndicator"></div>

    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/client.js"></script>
  </body>
</html>